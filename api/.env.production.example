# Produção (luizhenrique.dev.br/calculadora). No servidor: copiar para calculadora/api/.env.prod e preencher.
# A senha do banco NÃO fica aqui: vem de /root/calculadora-deploy.env pelo docker-compose.prod.yml.
APP_NAME=Calculadora
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://luizhenrique.dev.br/calculadora

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=calculadora
DB_USERNAME=calculadora

CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Mesmo domínio para app e API (o nginx do app repassa /api): sem CORS.
CORS_ALLOWED_ORIGINS=
# Validade do login em minutos (30 dias).
SANCTUM_EXPIRATION=43200

# Só no primeiro deploy, para o db:seed criar o login. Depois apague a linha da senha.
ADMIN_NAME="Luiz Henrique"
ADMIN_EMAIL=
ADMIN_PASSWORD=
